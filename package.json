{
  "name": "dsh-balance-plugin",
  "version": "0.1.0",
  "description": "DeepSeek API balance and token usage monitor for the dsh web sidebar",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/screenshot.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "balance",
    "usage",
    "dsh-plugin"
  ],
  "license": "MIT"
}
